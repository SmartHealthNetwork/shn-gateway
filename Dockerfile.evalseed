# gateway/Dockerfile.evalseed — builds the eval-bundle seed init binary.
FROM golang:1.26.11@sha256:7af425da11f4fc1a9308eb704369e3f6d1c44e35bac0f874a59ade3f20fdc07e AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /evalseed ./cmd/evalseed
FROM gcr.io/distroless/static-debian12:latest@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /evalseed /evalseed
ENTRYPOINT ["/evalseed"]
