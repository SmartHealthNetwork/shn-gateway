# gateway/Dockerfile.evalseed — builds the eval-bundle seed init binary.
FROM golang:1.26.10@sha256:5c3f3f28a273c9b61698b2d34f18375929790ab1f1d3835d032d21e2b31eae0c AS build
WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /evalseed ./cmd/evalseed
FROM gcr.io/distroless/static-debian12
COPY --from=build /evalseed /evalseed
ENTRYPOINT ["/evalseed"]
